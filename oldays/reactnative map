);


 //* CURRENT MARKER
 

let currentMarker =  null;

// * ACCURACY CIRCLE
 

let accuracyCircle = null;
 //* GREEN ROAD ROUTE
 

let routeLine = null;

// * FIT MAP

function fitRoute(
  currentLat,
  currentLng,
  route
) {
  const points = [
    [
      destinationLatitude,
      destinationLongitude
    ],
    [
      currentLat,
      currentLng
    ]
  ];

  if (
    Array.isArray(route) &&
    route.length
  ) {
    route.forEach(function(point) {
      points.push([
        Number(point.latitude),
        Number(point.longitude)
      ]);
    });
  }

  const bounds =
    L.latLngBounds(points);

  map.fitBounds(
    bounds,
    {
      padding: [40, 40],
      maxZoom: 17
    }
  );
}

// * UPDATE CURRENT LOCATION


window.updateCurrentLocation =
  function(data) {

    const currentLat =
      Number(data.latitude);

    const currentLng =
      Number(data.longitude);

    const accuracy =
      Number(data.accuracy || 0);

    if (
      !Number.isFinite(currentLat) ||
      !Number.isFinite(currentLng)
    ) {
      return;
    }

    
    // * Current marker

    if (!currentMarker) {

      currentMarker =
        L.marker(
          [
            currentLat,
            currentLng
          ],
          {
            icon: currentIcon
          }
        ).addTo(map);

      currentMarker
        .bindPopup(
          '<b>Your current location</b>'
        );

    } else {

      currentMarker.setLatLng([
        currentLat,
        currentLng
