  const [currentLocation, setCurrentLocation] =
    useState<Coordinates | null>(null);

  const [routePoints, setRoutePoints] =
    useState<RoutePoint[]>([]);

  const [locationLoading, setLocationLoading] =
    useState(true);

  const [routeLoading, setRouteLoading] =
    useState(false);

  const [locationError, setLocationError] =
    useState('');

  const latitude =
    Number(route.params?.latitude);

  const longitude =
    Number(route.params?.longitude);

  const title =
    route.params?.title ||
    'Work Location';

  const validDestination =
    Number.isFinite(latitude) &&
    Number.isFinite(longitude);

 //  * DISTANCE BETWEEN TWO GPS POINTS
 

  const distanceInMeters = useCallback(
    (
      a: Coordinates,
      b: Coordinates,
    ) => {
      const earthRadius = 6371000;

      const lat1 =
        (a.latitude * Math.PI) / 180;

      const lat2 =
        (b.latitude * Math.PI) / 180;

      const deltaLat =
        ((b.latitude - a.latitude) *
          Math.PI) /
        180;

      const deltaLng =
        ((b.longitude - a.longitude) *
          Math.PI) /
        180;

      const x =
        Math.sin(deltaLat / 2) *
          Math.sin(deltaLat / 2) +
        Math.cos(lat1) *
          Math.cos(lat2) *
          Math.sin(deltaLng / 2) *
          Math.sin(deltaLng / 2);

      const y =
        2 *
        Math.atan2(
          Math.sqrt(x),
          Math.sqrt(1 - x),
        );

      return earthRadius * y;
    },
    [],
  );
 //  * ANDROID LOCATION PERMISSION
 

  const requestLocationPermission =
    useCallback(async () => {
      if (Platform.OS !== 'android') {
        return true;
      }

      const granted =
        await PermissionsAndroid.request(
          PermissionsAndroid.PERMISSIONS.ACCESS_FINE_LOCATION,
          {
            title:
              'BuildSkil Location Permission',

            message:
              'BuildSkil needs your current location to show your route to the work location.',

            buttonPositive:
              'Allow',

            buttonNegative:
              'Deny',

            buttonNeutral:
              'Ask Me Later',
          },
        );

      return (
        granted ===
        PermissionsAndroid.RESULTS.GRANTED
      );
    }, []);
   //* GET ROAD ROUTE FROM CURRENT LOCATION TO DESTINATION
   

  const fetchRoadRoute =
    useCallback(
      async (
        from: Coordinates,
        to: RoutePoint,
      ) => {
        try {
          setRouteLoading(true);

          
           //* OSRM expects:
           //* longitude,latitude

          const url =
            `https://router.project-osrm.org/route/v1/driving/` +
            `${from.longitude},${from.latitude};` +
            `${to.longitude},${to.latitude}` +
            `?overview=full&geometries=geojson`;

          const response =
            await fetch(url);

          if (!response.ok) {
            throw new Error(
              'Route service failed.',
            );
          }

          const data =
            await response.json();

          const coordinates =
            data?.routes?.[0]?.geometry
              ?.coordinates;

          if (
            !Array.isArray(coordinates) ||
            !coordinates.length
          ) {
            throw new Error(
              'No road route found.',
            );
          }

          const points: RoutePoint[] =
            coordinates
              .map(
                (point: any) => ({
                  longitude:
                    Number(point[0]),

                  latitude:
                    Number(point[1]),
                }),
              )
              .filter(
                (point: RoutePoint) =>
                  Number.isFinite(
                    point.latitude,
                  ) &&
                  Number.isFinite(
                    point.longitude,
                  ),
              );

          if (!points.length) {
            throw new Error(
              'Invalid route received.',
            );
          }

          setRoutePoints(points);

          lastRoutedLocationRef.current =
            from;

          
           //* Update map immediately
           
          sendMapData(
            from,
            points,
          );
        } catch (error) {
          console.log(
            'ROUTE ERROR:',
            error,
          );

          // * Fallback:
          // * draw direct green line
          // * if road routing fails.
           

          const fallbackRoute: RoutePoint[] =
            [
              {
                latitude:
                  from.latitude,

                longitude:
                  from.longitude,
              },

              {
                latitude:
                  to.latitude,

                longitude:
                  to.longitude,
              },
            ];

          setRoutePoints(
            fallbackRoute,
          );

          lastRoutedLocationRef.current =
            from;

          sendMapData(
            from,
            fallbackRoute,
          );
        } finally {
          setRouteLoading(false);
        }
      },
      [],
    );

 
  // * SEND DATA TO LEAFLET WEBVIEW
  const sendMapData =
    useCallback(
      (
        location: Coordinates,
        points: RoutePoint[] = [],
      ) => {
        if (!webViewRef.current) {
          return;
        }

        const payload = {
          latitude:
            location.latitude,

          longitude:
            location.longitude,

          accuracy:
            location.accuracy || 0,

          route:
            points,
        };

        const javascript =
          `
          if (window.updateCurrentLocation) {
            window.updateCurrentLocation(
              ${JSON.stringify(payload)}
            );
          }
          true;
          `;

        webViewRef.current.injectJavaScript(
          javascript,
        );
      },
      [],
    );
  // * HANDLE CURRENT LOCATION
  const handleLocation =
    useCallback(
      async (
        position: any,
      ) => {
        const nextLocation: Coordinates =
          {
            latitude:
              Number(
                position.coords.latitude,
              ),

            longitude:
              Number(
                position.coords.longitude,
              ),

            accuracy:
              Number(
                position.coords.accuracy || 0,
              ),
          };

        if (
          !Number.isFinite(
            nextLocation.latitude,
          ) ||
          !Number.isFinite(
            nextLocation.longitude,
          )
        ) {
          return;
        }

        setCurrentLocation(
          nextLocation,
        );

        setLocationLoading(false);
        setLocationError('');
        // * Show current marker immediately.
        sendMapData(
          nextLocation,
          routePoints,
        );
         //* Recalculate road route:
        // * - First GPS position
        // * - Or after moving ~20 metres
         

        const lastRouteLocation =
          lastRoutedLocationRef.current;

        const shouldFetchRoute =
          !lastRouteLocation ||
          distanceInMeters(
            lastRouteLocation,
            nextLocation,
          ) >= 20;

        if (
          shouldFetchRoute &&
          validDestination
        ) {
          await fetchRoadRoute(
            nextLocation,
            {
              latitude,
              longitude,
            },
          );
        }
      },
      [
        distanceInMeters,
        fetchRoadRoute,
        latitude,
        longitude,
        routePoints,
        sendMapData,
        validDestination,
      ],
    );

   //* START GPS
const startLocationTracking =
  useCallback(
    async () => {
      try {
        const allowed =
          await requestLocationPermission();

        if (!allowed) {
          setLocationLoading(false);

          setLocationError(
            'Location permission was denied.',
          );

          return;
        }

        setLocationLoading(true);
        setLocationError('');

        // * GET FIRST LOCATION

        const getFirstLocation = () => {
          Geolocation.getCurrentPosition(
            position => {
              console.log(
                'CURRENT LOCATION:',
                position.coords.latitude,
                position.coords.longitude,
                'accuracy:',
                position.coords.accuracy,
              );

              void handleLocation(
                position,
              );
            },

            error => {
              console.log(
                'CURRENT LOCATION ERROR:',
                error,
              );

              // * Error code 3 = TIMEOUT
              // * Retry with lower accuracy.
               
              if (error?.code === 3) {
                console.log(
                  'GPS timed out. Retrying with network location...',
                );

                Geolocation.getCurrentPosition(
                  position => {
                    console.log(
                      'FALLBACK LOCATION:',
                      position.coords.latitude,
                      position.coords.longitude,
                    );

                    void handleLocation(
                      position,
                    );
                  },

                  fallbackError => {
                    console.log(
                      'FALLBACK LOCATION ERROR:',
                      fallbackError,
                    );

                    setLocationLoading(
                      false,
                    );

                    setLocationError(
                      'Unable to get your current location. Turn on GPS/location and try again.',
                    );
                  },

                  {
                    enableHighAccuracy: false,
                    timeout: 30000,
                    maximumAge: 10000,
                  },
                );

                return;
              }

              setLocationLoading(false);

              setLocationError(
                error?.message ||
                  'Could not get your current location.',
              );
            },

            {
              enableHighAccuracy: true,
              timeout: 60000,
              maximumAge: 10000,
            },
          );
        };

        getFirstLocation();
        // * CONTINUOUS LOCATION WATCH

        const watchId =
          Geolocation.watchPosition(
            position => {
              console.log(
                'LIVE LOCATION:',
                position.coords.latitude,
                position.coords.longitude,
              );

              void handleLocation(
                position,
              );
            },

            error => {
              console.log(
                'WATCH LOCATION ERROR:',
                error,
              );
            },

            {
              enableHighAccuracy: true,
              distanceFilter: 10,
              interval: 5000,
              fastestInterval: 3000,
            },
          );

        watchIdRef.current =
          watchId;
      } catch (error) {
        console.log(
          'LOCATION START ERROR:',
          error,
        );

        setLocationLoading(false);

        setLocationError(
          'Unable to start location tracking.',
        );
      }
    },
    [
      handleLocation,
      requestLocationPermission,
    ],
  );

  
  // * CLEAN UP GPS

