      } else {

        accuracyCircle.setLatLng([
          currentLat,
          currentLng
        ]);

        accuracyCircle.setRadius(
          accuracy
        );
      }
    }

    
    // * GREEN ROUTE

    if (
      Array.isArray(data.route) &&
      data.route.length
    ) {

      const routeLatLngs =
        data.route.map(
          function(point) {
            return [
              Number(point.latitude),
              Number(point.longitude)
            ];
